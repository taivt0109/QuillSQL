<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <VisualStudioVersion Condition="'$(VisualStudioVersion)' == ''">17.0</VisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
  </PropertyGroup>
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectTypeGuids>{82b43b9b-a64c-4715-b499-d71e9ca2bd60};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <ProjectGuid>{6B2E1F4A-8C3D-4E57-A1B9-0D7F2C5E9A13}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>QuillSql.Vsix</RootNamespace>
    <AssemblyName>QuillSql.Vsix</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>false</CopyOutputSymbolsToOutputDirectory>
    <!-- The target is SSMS, not this machine's Visual Studio experimental instance. -->
    <DeployExtension>false</DeployExtension>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <Optimize>true</Optimize>
    <RepoRoot>$(MSBuildProjectDirectory)\..\..</RepoRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AiAssistant.cs" />
    <Compile Include="CodeAnalysis.cs" />
    <Compile Include="Commands.cs" />
    <Compile Include="CompletionController.cs" />
    <Compile Include="CompletionPopup.cs" />
    <Compile Include="ConnectionResolver.cs" />
    <Compile Include="Database.cs" />
    <Compile Include="EditorContext.cs" />
    <Compile Include="EditorExtensions.cs" />
    <Compile Include="EditorWatcher.cs" />
    <Compile Include="EngineProcess.cs" />
    <Compile Include="FormatterProcess.cs" />
    <Compile Include="Json.cs" />
    <Compile Include="Log.cs" />
    <Compile Include="MetadataLoader.cs" />
    <Compile Include="PlanCapture.cs" />
    <Compile Include="QueryHistory.cs" />
    <Compile Include="TabColorizer.cs" />
    <Compile Include="Theme.cs" />
    <Compile Include="Updater.cs" />
    <Compile Include="CardPopup.cs" />
    <Compile Include="Loc.cs" />
    <Compile Include="MenuTexts.cs" />
    <Compile Include="TextCommands.cs" />
    <Compile Include="Settings.cs" />
    <Compile Include="OptionsWindow.cs" />
    <Compile Include="ObjectScripts.cs" />
    <Compile Include="QuillSqlPackage.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <VSCTCompile Include="QuillSqlPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <Content Include="$(RepoRoot)\LICENSE">
      <Link>LICENSE</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="$(RepoRoot)\assets\logo\png\quillsql-90.png">
      <Link>quillsql-90.png</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="$(RepoRoot)\assets\logo\png\quillsql-200.png">
      <Link>quillsql-200.png</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="$(RepoRoot)\target\release\quill.exe">
      <Link>quill.exe</Link>
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Design" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.31902.203" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.2142" />
    <!-- SSMS 21 ships this version; compile against it and use SSMS's copy at run time. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.6" ExcludeAssets="runtime" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="'$(VSToolsPath)' != ''" />
  <Target Name="BuildRustEngine" BeforeTargets="PrepareForBuild;ResolveReferences">
    <Exec Command="cargo build --release" WorkingDirectory="$(RepoRoot)" />
  </Target>
</Project>
