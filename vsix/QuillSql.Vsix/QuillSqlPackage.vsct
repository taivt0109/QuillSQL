          <LocCanonicalName>.QuillSQL.AnalyzeActualPlanWithAI</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidQuillSqlCmdSet" id="SlowQueriesAiCommandId" priority="0x0105" type="Button">
        <Parent guid="guidQuillSqlCmdSet" id="AiGroup" />
        <Strings>
          <ButtonText>Find Slow Queries with AI (Query Store)</ButtonText>
