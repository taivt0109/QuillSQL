        <Strings>
          <ButtonText>Analyze Code</ButtonText>
          <CanonicalName>.QuillSQL.AnalyzeCode</CanonicalName>
          <LocCanonicalName>.QuillSQL.AnalyzeCode</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidQuillSqlCmdSet" id="FixIssuesCommandId" priority="0x0101" type="Button">
        <Parent guid="guidQuillSqlCmdSet" id="AnalysisGroup" />
        <Strings>
          <ButtonText>Fix Code Issues</ButtonText>
          <CanonicalName>.QuillSQL.FixCodeIssues</CanonicalName>
          <LocCanonicalName>.QuillSQL.FixCodeIssues</LocCanonicalName>
