<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidQuillSqlPackage">
    <Menus>
      <Menu guid="guidQuillSqlCmdSet" id="QuillSqlMenu" priority="0x0100" type="Menu">
        <Parent guid="guidQuillSqlCmdSet" id="ToolsGroup" />
        <Strings>
          <ButtonText>QuillSQL</ButtonText>
        </Strings>
      </Menu>
    </Menus>
    <Groups>
      <Group guid="guidQuillSqlCmdSet" id="ToolsGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
      <Group guid="guidQuillSqlCmdSet" id="EditGroup" priority="0x0100">
        <Parent guid="guidQuillSqlCmdSet" id="QuillSqlMenu" />
      </Group>
      <Group guid="guidQuillSqlCmdSet" id="RefactorGroup" priority="0x0200">
        <Parent guid="guidQuillSqlCmdSet" id="QuillSqlMenu" />
      </Group>
      <Group guid="guidQuillSqlCmdSet" id="AnalysisGroup" priority="0x0300">
        <Parent guid="guidQuillSqlCmdSet" id="QuillSqlMenu" />
      </Group>
      <Group guid="guidQuillSqlCmdSet" id="DatabaseGroup" priority="0x0400">
        <Parent guid="guidQuillSqlCmdSet" id="QuillSqlMenu" />
      </Group>
      <Group guid="guidQuillSqlCmdSet" id="AiGroup" priority="0x0500">
        <Parent guid="guidQuillSqlCmdSet" id="QuillSqlMenu" />
      </Group>
      <Group guid="guidQuillSqlCmdSet" id="AboutGroup" priority="0x0600">
        <Parent guid="guidQuillSqlCmdSet" id="QuillSqlMenu" />
      </Group>
    </Groups>
    <Buttons>
      <Button guid="guidQuillSqlCmdSet" id="FormatCommandId" priority="0x0100" type="Button">
        <Parent guid="guidQuillSqlCmdSet" id="EditGroup" />
        <Strings>
          <ButtonText>Format T-SQL</ButtonText>
          <CanonicalName>.Tools.FormatTSQL</CanonicalName>
          <LocCanonicalName>.Tools.FormatTSQL</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidQuillSqlCmdSet" id="RefreshCommandId" priority="0x0100" type="Button">
        <Parent guid="guidQuillSqlCmdSet" id="DatabaseGroup" />
        <Strings>
          <ButtonText>Refresh T-SQL Suggestions</ButtonText>
          <CanonicalName>.Tools.RefreshTSQLSuggestions</CanonicalName>
          <LocCanonicalName>.Tools.RefreshTSQLSuggestions</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidQuillSqlCmdSet" id="InsertSnippetCommandId" priority="0x0101" type="Button">
        <Parent guid="guidQuillSqlCmdSet" id="EditGroup" />
        <Strings>
          <ButtonText>Insert Snippet...</ButtonText>
          <CanonicalName>.QuillSQL.InsertSnippet</CanonicalName>
          <LocCanonicalName>.QuillSQL.InsertSnippet</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidQuillSqlCmdSet" id="ExpandWildcardsCommandId" priority="0x0100" type="Button">
        <Parent guid="guidQuillSqlCmdSet" id="RefactorGroup" />
        <Strings>
          <ButtonText>Expand Wildcards</ButtonText>
          <CanonicalName>.QuillSQL.ExpandWildcards</CanonicalName>
          <LocCanonicalName>.QuillSQL.ExpandWildcards</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidQuillSqlCmdSet" id="QualifyCommandId" priority="0x0101" type="Button">
        <Parent guid="guidQuillSqlCmdSet" id="RefactorGroup" />
        <Strings>
          <ButtonText>Qualify Object Names</ButtonText>
          <CanonicalName>.QuillSQL.QualifyObjectNames</CanonicalName>
          <LocCanonicalName>.QuillSQL.QualifyObjectNames</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidQuillSqlCmdSet" id="AddAsCommandId" priority="0x0102" type="Button">
        <Parent guid="guidQuillSqlCmdSet" id="RefactorGroup" />
        <Strings>
          <ButtonText>Add AS to Aliases</ButtonText>
          <CanonicalName>.QuillSQL.AddAs</CanonicalName>
          <LocCanonicalName>.QuillSQL.AddAs</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidQuillSqlCmdSet" id="RemoveAsCommandId" priority="0x0103" type="Button">
        <Parent guid="guidQuillSqlCmdSet" id="RefactorGroup" />
        <Strings>
          <ButtonText>Remove AS from Aliases</ButtonText>
          <CanonicalName>.QuillSQL.RemoveAs</CanonicalName>
          <LocCanonicalName>.QuillSQL.RemoveAs</LocCanonicalName>
        </Strings>
