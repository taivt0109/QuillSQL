      </Button>
      <Button guid="guidQuillSqlCmdSet" id="ExplainAiCommandId" priority="0x0101" type="Button">
        <Parent guid="guidQuillSqlCmdSet" id="AiGroup" />
        <Strings>
          <ButtonText>Explain with AI</ButtonText>
          <CanonicalName>.QuillSQL.ExplainWithAI</CanonicalName>
          <LocCanonicalName>.QuillSQL.ExplainWithAI</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidQuillSqlCmdSet" id="ReviewAiCommandId" priority="0x0102" type="Button">
        <Parent guid="guidQuillSqlCmdSet" id="AiGroup" />
        <Strings>
          <ButtonText>Review with AI</ButtonText>
