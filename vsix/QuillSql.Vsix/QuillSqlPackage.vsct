        <Parent guid="guidQuillSqlCmdSet" id="RefactorGroup" />
        <Strings>
          <ButtonText>Inline EXEC</ButtonText>
          <CanonicalName>.QuillSQL.InlineExec</CanonicalName>
          <LocCanonicalName>.QuillSQL.InlineExec</LocCanonicalName>
        </Strings>
      </Button>
