        <Strings>
          <ButtonText>Smart Rename...</ButtonText>
          <CanonicalName>.QuillSQL.SmartRename</CanonicalName>
          <LocCanonicalName>.QuillSQL.SmartRename</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidQuillSqlCmdSet" id="EncapsulateCommandId" priority="0x0105" type="Button">
        <Parent guid="guidQuillSqlCmdSet" id="RefactorGroup" />
        <Strings>
          <ButtonText>Encapsulate as Stored Procedure...</ButtonText>
          <CanonicalName>.QuillSQL.EncapsulateAsProcedure</CanonicalName>
          <LocCanonicalName>.QuillSQL.EncapsulateAsProcedure</LocCanonicalName>
        </Strings>
      </Button>
