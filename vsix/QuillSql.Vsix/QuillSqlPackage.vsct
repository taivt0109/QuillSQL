        <Parent guid="guidQuillSqlCmdSet" id="AboutGroup" />
        <Strings>
          <ButtonText>Check for Updates</ButtonText>
          <CanonicalName>.QuillSQL.CheckForUpdates</CanonicalName>
          <LocCanonicalName>.QuillSQL.CheckForUpdates</LocCanonicalName>
        </Strings>
